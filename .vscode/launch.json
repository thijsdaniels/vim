	"version": "0.2.0",
	"configurations": [
		{
			"name": "Vim",
			"type": "dart",
			"request": "launch",
			"args": ["--web-renderer", "canvaskit"]
		},
		{
			"name": "Vim (Profile)",
			"type": "dart",
			"request": "launch",
			"flutterMode": "profile",
			"args": ["--web-renderer", "canvaskit"]
		},
