			"name": "Vim (Release)",
			"type": "dart",
			"request": "launch",
			"flutterMode": "release",
			"args": ["--web-renderer", "canvaskit"]
		},
		{
			"name": "Widgetbook",
			"type": "dart",
			"request": "launch",
			"program": "widgetbook/widgetbook.dart",
			"args": ["--web-renderer", "canvaskit"]
		}
	]
